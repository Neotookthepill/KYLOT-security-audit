# Inventory only. Never use these example values in production.
# Run `python3 backend/preflight.py --strict` with the real deploy environment.

# Runtime
ENVIRONMENT=development
APP_VERSION=local
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Database and authentication — replace every placeholder
MONGO_URL=mongodb://localhost:27017
DB_NAME=kylot
JWT_SECRET=replace-with-at-least-32-random-bytes
ALLOW_PUBLIC_REGISTRATION=false
ALLOW_DEMO_DATA=false
ALLOW_TOKEN_RESPONSE=false
RUN_STARTUP_MIGRATIONS=false
EXPOSE_API_DOCS=false
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Initial accounts — only used by the existing bootstrap code
ADMIN_EMAIL=admin@example.invalid
ADMIN_PASSWORD=replace-me
SUPER_ADMIN_EMAIL=superadmin@example.invalid
SUPER_ADMIN_PASSWORD=replace-me

# Login protection
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MIN=15
LOGIN_LOCKOUT_MIN=15
LOGIN_SOURCE_MAX_ATTEMPTS=30
# Only enable behind a trusted reverse proxy that overwrites X-Forwarded-For.
TRUST_PROXY_HEADERS=false

# Upload and request limits
MAX_UPLOAD_BYTES=10485760
MAX_UPLOAD_FILES=5
MAX_PDF_PAGES=10
MAX_REQUEST_BYTES=20971520
MAX_INLINE_IMAGE_BYTES=4194304
MAX_PHOTOS_PER_ENTITY=20
PHOTO_ALLOWED_HOSTS=

# Client imports
MAX_IMPORT_ROWS=5000
MAX_IMPORT_COLUMNS=100
MAX_IMPORT_CELL_CHARS=10000
IMPORT_BATCH_TTL_MINUTES=30

# AI cost controls
AI_RATE_LIMIT_PER_MINUTE=20
AI_DAILY_REQUEST_QUOTA=200

# External services
# Explicit opt-in: prompts and uploaded documents may contain personal data.
ALLOW_EXTERNAL_AI=false
EMERGENT_LLM_KEY=
EMERGENT_EMAIL_KEY=
EMAIL_FROM_NAME=KYLOT
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_RETURN_ORIGINS=http://localhost:3000
WEBHOOK_CRON_SECRET=
# Client addresses are personal data; enable only with an approved provider/DPA.
ALLOW_EXTERNAL_GEOCODING=false
