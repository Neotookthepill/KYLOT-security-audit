# Copy to deploy/secrets/backend.env. Never commit the resulting file.
ENVIRONMENT=production
APP_VERSION=replace-with-git-commit
MONGO_URL=mongodb://replace-with-private-managed-mongodb-uri
DB_NAME=kylot
JWT_SECRET=replace-with-at-least-32-random-characters
FRONTEND_URL=https://replace-with-public-domain
CORS_ORIGINS=https://replace-with-public-domain

ALLOW_PUBLIC_REGISTRATION=false
ALLOW_DEMO_DATA=false
ALLOW_TOKEN_RESPONSE=false
RUN_STARTUP_MIGRATIONS=false
EXPOSE_API_DOCS=false
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
TRUST_PROXY_HEADERS=true

ADMIN_EMAIL=replace-with-admin-email
ADMIN_PASSWORD=replace-with-unique-long-password
SUPER_ADMIN_EMAIL=replace-with-owner-email
SUPER_ADMIN_PASSWORD=replace-with-another-unique-long-password

ALLOW_EXTERNAL_AI=false
ALLOW_EXTERNAL_GEOCODING=false
EMERGENT_LLM_KEY=
EMERGENT_EMAIL_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_RETURN_ORIGINS=https://replace-with-public-domain
WEBHOOK_CRON_SECRET=

MAX_UPLOAD_BYTES=10485760
MAX_UPLOAD_FILES=5
MAX_PDF_PAGES=10
MAX_REQUEST_BYTES=20971520
MAX_INLINE_IMAGE_BYTES=4194304
MAX_PHOTOS_PER_ENTITY=20
PHOTO_ALLOWED_HOSTS=
MAX_IMPORT_ROWS=5000
MAX_IMPORT_COLUMNS=100
MAX_IMPORT_CELL_CHARS=10000
IMPORT_BATCH_TTL_MINUTES=30
AI_RATE_LIMIT_PER_MINUTE=20
AI_DAILY_REQUEST_QUOTA=200
